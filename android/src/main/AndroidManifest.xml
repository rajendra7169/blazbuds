<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talking to paired earbuds. No internet, no location. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Only to hear how loud the room is before the EarPrint hearing check. Nothing is recorded or kept. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The low-battery alert and the connect notice, and the battery check every quarter hour that carries on after a
         restart (it also wakes the automations set for a time of day). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only to ask GitHub whether a newer Blazbuds is out; can be switched off in Settings. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The card that greets the earbuds as they connect, over whatever is on screen; asked for in Settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Blazbuds"
        android:supportsRtl="true"
        android:theme="@style/Theme.Blazbuds">
        <activity
            android:name=".android.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The icon's long-press shortcuts, which Google Assistant can open by name too. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- blazbuds:// links from shortcuts, the Assistant and automation apps: makes the change and closes. -->
        <activity
            android:name=".android.ActionActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="blazbuds" />
            </intent-filter>
        </activity>

        <!-- Wakes at each time automation's minute, and plans those again after a restart or an update. -->
        <receiver android:name=".android.RuleAlarm" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The home-screen widget, and the mode taps it sends. -->
        <receiver android:name=".android.BudsWidget" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>
        <receiver android:name=".android.WidgetAction" android:exported="false" />

        <!-- Hears the earbuds connect, even with the app closed, for the connect card. -->
        <receiver android:name=".android.ConnectReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

        <!-- A look at the batteries now and then while the app is closed. -->
        <service
            android:name=".android.BatteryJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The quick-settings tile. -->
        <service
            android:name=".android.ModeTile"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
