<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="widget_background">#FFFFFF</color>
    <color name="widget_text">#121619</color>
    <color name="widget_muted">#5A646C</color>
    <color name="widget_chip">#EDF1F3</color>
    <color name="widget_on">#0F9488</color>
    <color name="widget_on_text">#FFFFFF</color>

    <style name="WidgetLevel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <style name="WidgetValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/widget_muted</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="WidgetMode">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
